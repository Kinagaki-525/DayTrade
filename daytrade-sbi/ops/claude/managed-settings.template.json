{
  "requiredMinimumVersion": "2.1.251",
  "requiredMaximumVersion": "2.1.251",

  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",

    "additionalDirectories": [
      "__PROJECT_ROOT__"
    ],

    "allow": [
      "Bash(__PRODUCTION_PYTHON__ -B -m src.cli *)",
      "Edit(__EVENT_EXTRACTION_PATH_PATTERN__)"
    ],

    "deny": [
      "WebSearch",
      "WebFetch",
      "Agent",
      "mcp__*",
      "SendMessage",
      "ListAgents",
      "Read(//etc/claude-code/**)",
      "Read(~/.claude/**)"
    ]
  },

  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,

  "allowedMcpServers": [],

  "disableClaudeAiConnectors": true,
  "disableAgentView": true,
  "disableArtifact": true,
  "disableBrowserExternalNavigation": true,
  "disableDeepLinkRegistration": "disable",
  "disableSkillShellExecution": true,
  "disableSideloadFlags": true,
  "remoteControlAtStartup": false,
  "crossSessionInbound": "refuse",

  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],

    "filesystem": {
      "disabled": false,
      "denyWrite": [
        "__DAYTRADE_ROOT__/src",
        "__DAYTRADE_ROOT__/config",
        "__DAYTRADE_ROOT__/schemas",
        "__DAYTRADE_ROOT__/ops",
        "__DAYTRADE_ROOT__/scripts",
        "__PROJECT_ROOT__/.claude"
      ]
    },

    "network": {
      "strictAllowlist": true,
      "allowManagedDomainsOnly": true,
      "allowLocalBinding": false,
      "allowAllUnixSockets": false,
      "allowedDomains": __ALLOWED_DOMAINS_JSON__
    }
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__PRODUCTION_PYTHON__",
            "args": [
              "-I",
              "-B",
              "__MANAGED_GUARD_PATH__"
            ]
          }
        ]
      }
    ]
  }
}
