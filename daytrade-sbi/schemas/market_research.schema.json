{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_research.schema.json",
  "title": "Nightly market research discovery and source audit",
  "type": "object",
  "required": [
    "schema_version",
    "target_date",
    "previous_trading_day",
    "research_cutoff",
    "research_executed_at",
    "research_window",
    "market_filter",
    "overall_status",
    "discovery",
    "discovery_candidates",
    "candidate_research"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "target_date": {"type": "string", "format": "date"},
    "previous_trading_day": {"type": "string", "format": "date"},
    "research_cutoff": {"type": "string", "format": "date-time"},
    "research_executed_at": {"type": "string", "format": "date-time"},
    "research_window": {"$ref": "#/$defs/researchWindow"},
    "market_filter": {"enum": ["ALL_MARKETS", "TSE_ONLY"]},
    "overall_status": {
      "enum": [
        "COMPLETE",
        "DISCOVERY_INCOMPLETE",
        "DATA_UNAVAILABLE",
        "SOURCE_POLICY_UNDEFINED",
        "PIPELINE_INCOMPLETE"
      ]
    },
    "discovery": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/discoveryRoute"}
    },
    "discovery_candidates": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/discoveryCandidate"}
    },
    "candidate_research": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidateResearch"}
    },
    "subagent_batches": {
      "type": "array",
      "items": {"$ref": "#/$defs/subagentBatch"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sourceStatus": {
      "enum": [
        "NOT_STARTED",
        "FOUND",
        "NOT_FOUND",
        "NOT_YET_AVAILABLE",
        "ACCESS_FAILED",
        "PARSE_FAILED",
        "STALE",
        "CONFLICT",
        "SINGLE_SOURCE_ONLY",
        "SOURCE_POLICY_UNDEFINED",
        "NOT_REQUIRED",
        "DEPENDENCY_NOT_READY",
        "EXECUTION_FAILED"
      ]
    },
    "researchWindow": {
      "type": "object",
      "required": [
        "run_type",
        "window_start",
        "window_end",
        "previous_research_cutoff",
        "previous_run_date",
        "bootstrap_lookback_days"
      ],
      "properties": {
        "run_type": {"enum": ["FIRST_RUN", "NORMAL_RUN"]},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"},
        "previous_research_cutoff": {"type": ["string", "null"], "format": "date-time"},
        "previous_run_date": {"type": ["string", "null"], "format": "date"},
        "bootstrap_lookback_days": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["run_type"],
            "properties": {"run_type": {"const": "FIRST_RUN"}}
          },
          "then": {
            "properties": {
              "previous_research_cutoff": {"type": "null"},
              "previous_run_date": {"type": "null"},
              "bootstrap_lookback_days": {"type": "integer", "minimum": 1}
            }
          }
        },
        {
          "if": {
            "required": ["run_type"],
            "properties": {"run_type": {"const": "NORMAL_RUN"}}
          },
          "then": {
            "properties": {
              "previous_research_cutoff": {"type": "string", "format": "date-time"},
              "previous_run_date": {"type": "string", "format": "date"},
              "bootstrap_lookback_days": {"type": "null"}
            }
          }
        }
      ]
    },
    "discoveryType": {
      "enum": ["VOLUME_RANKING", "PRICE_GAIN_RANKING"]
    },
    "dataStatus": {
      "enum": [
        "NOT_STARTED",
        "VERIFIED",
        "DATA_UNAVAILABLE",
        "CONFLICT",
        "SINGLE_SOURCE_ONLY",
        "SOURCE_POLICY_UNDEFINED"
      ]
    },
    "discoveryRoute": {
      "type": "object",
      "required": [
        "discovery_type",
        "source_id",
        "status",
        "source_url",
        "retrieved_at",
        "result_count",
        "items"
      ],
      "properties": {
        "discovery_type": {"$ref": "#/$defs/discoveryType"},
        "source_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "status": {"$ref": "#/$defs/sourceStatus"},
        "source_url": {"type": "string", "pattern": "^https?://"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "result_count": {"type": ["integer", "null"], "minimum": 0},
        "items": {
          "type": "array",
          "items": {"$ref": "#/$defs/discoveryItem"}
        },
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "FOUND"}}
          },
          "then": {
            "properties": {"result_count": {"type": "integer", "minimum": 0}}
          },
          "else": {
            "properties": {"result_count": {"type": "null"}}
          }
        }
      ]
    },
    "discoveryItem": {
      "type": "object",
      "required": [
        "ticker",
        "company_name",
        "market",
        "source_url",
        "retrieved_at"
      ],
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1},
        "market": {"type": ["string", "null"]},
        "rank": {"type": ["integer", "null"], "minimum": 1},
        "display_value": {"type": ["string", "number", "integer", "null"]},
        "disclosure_datetime": {"type": ["string", "null"], "format": "date-time"},
        "title": {"type": ["string", "null"]},
        "source_url": {"type": "string", "pattern": "^https?://"},
        "retrieved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "discoveryReason": {
      "type": "object",
      "required": ["discovery_type", "source_id", "source_url"],
      "properties": {
        "discovery_type": {"$ref": "#/$defs/discoveryType"},
        "source_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "source_url": {"type": "string", "pattern": "^https?://"},
        "rank": {"type": ["integer", "null"], "minimum": 1},
        "display_value": {"type": ["string", "number", "integer", "null"]},
        "title": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "discoveryCandidate": {
      "type": "object",
      "required": [
        "ticker",
        "company_name",
        "market",
        "discovered_by",
        "discovery_reasons"
      ],
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1},
        "market": {"type": ["string", "null"]},
        "discovered_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/discoveryType"}
        },
        "discovery_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/discoveryReason"}
        }
      },
      "additionalProperties": false
    },
    "candidateResearch": {
      "type": "object",
      "required": [
        "ticker",
        "data_status",
        "status_reasons",
        "source_policy_status",
        "universe_status",
        "stage1_status",
        "stage2_status",
        "context_research_status",
        "source_checks",
        "source_attempt_ids"
      ],
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "data_status": {"$ref": "#/$defs/dataStatus"},
        "status_reasons": {"type": "array", "items": {"type": "string"}},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "missing_requirements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "required_capital_yen": {"$ref": "#/$defs/decimalOrNull"},
        "source_policy_status": {"$ref": "#/$defs/sourceStatus"},
        "universe_status": {
          "enum": ["NOT_STARTED", "PASSED", "REJECTED", "DATA_UNAVAILABLE", "SKIPPED"]
        },
        "stage1_status": {
          "enum": ["NOT_STARTED", "PASSED", "REJECTED", "DATA_UNAVAILABLE", "SKIPPED"]
        },
        "stage1_reasons": {"type": "array", "items": {"type": "string"}},
        "stage1_checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/stage1Check"}
        },
        "stage2_status": {
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE", "DATA_UNAVAILABLE", "SKIPPED"]
        },
        "stage2_reasons": {"type": "array", "items": {"type": "string"}},
        "context_research_status": {
          "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE", "DATA_UNAVAILABLE", "SKIPPED"]
        },
        "source_checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceCheck"}
        },
        "source_attempt_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "decimalOrNull": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
        {"type": "null"}
      ]
    },
    "sourceCheckId": {
      "enum": [
        "listed_company",
        "trading_unit",
        "primary_ohlcv",
        "secondary_ohlcv",
        "tick_size",
        "topix500_membership",
        "earnings_schedule",
        "tdnet",
        "news_context"
      ]
    },
    "sourceCheck": {
      "type": "object",
      "required": [
        "check_id",
        "status",
        "source_refs",
        "source_attempt_ids"
      ],
      "properties": {
        "check_id": {"$ref": "#/$defs/sourceCheckId"},
        "status": {"$ref": "#/$defs/sourceStatus"},
        "source_id": {"type": ["string", "null"], "pattern": "^[A-Z0-9_]+$"},
        "information_type": {"type": ["string", "null"]},
        "reason_code": {"type": ["string", "null"], "minLength": 1},
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_attempt_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "subagentLifecycleStatus": {
      "enum": ["REQUESTED", "RETURNED", "VALIDATED", "MERGED"]
    },
    "subagentBatch": {
      "type": "object",
      "required": [
        "batch_id",
        "agent_name",
        "lifecycle_status",
        "candidate_codes",
        "returned_candidate_codes",
        "merged_candidate_codes"
      ],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "agent_name": {"type": "string", "minLength": 1},
        "lifecycle_status": {"$ref": "#/$defs/subagentLifecycleStatus"},
        "candidate_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "returned_candidate_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "merged_candidate_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "stage1Check": {
      "type": "object",
      "required": [
        "check_id",
        "status",
        "reason_code",
        "source_refs",
        "source_attempt_ids"
      ],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "NOT_STARTED",
            "PASSED",
            "REJECTED",
            "DATA_UNAVAILABLE",
            "SKIPPED"
          ]
        },
        "reason_code": {"type": ["string", "null"], "minLength": 1},
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_attempt_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
