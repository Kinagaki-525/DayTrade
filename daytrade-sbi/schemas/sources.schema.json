{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "title": "Nightly source ledger",
  "type": "object",
  "required": [
    "schema_version",
    "target_date",
    "sources",
    "source_attempts"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        3
      ]
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceValue"
      }
    },
    "source_attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceAttempt"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceStatus": {
      "enum": [
        "NOT_STARTED",
        "FOUND",
        "NOT_FOUND",
        "NOT_YET_AVAILABLE",
        "ACCESS_FAILED",
        "PARSE_FAILED",
        "STALE",
        "CONFLICT",
        "SINGLE_SOURCE_ONLY",
        "SOURCE_POLICY_UNDEFINED",
        "NOT_REQUIRED",
        "DEPENDENCY_NOT_READY",
        "EXECUTION_FAILED"
      ]
    },
    "sourceRole": {
      "enum": [
        "PRIMARY",
        "SECONDARY",
        "AUDIT",
        "CONTEXT"
      ]
    },
    "criticality": {
      "enum": [
        "TRADE_CRITICAL",
        "DISCOVERY_CRITICAL",
        "RULE_DEPENDENT",
        "CONTEXT"
      ]
    },
    "sourceValue": {
      "type": "object",
      "required": [
        "source_ref",
        "source_id",
        "source_role",
        "information_type",
        "source_status",
        "source_name",
        "source_url",
        "retrieved_at",
        "trading_date",
        "ticker",
        "field_name",
        "value"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "source_role": {
          "$ref": "#/$defs/sourceRole"
        },
        "information_type": {
          "type": "string",
          "minLength": 1
        },
        "source_status": {
          "const": "FOUND"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "trading_date": {
          "type": "string",
          "format": "date"
        },
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "not": {
            "type": "null"
          }
        }
      },
      "additionalProperties": false
    },
    "sourceAttempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "source_id",
        "source_role",
        "criticality",
        "information_type",
        "candidate_code",
        "target_date",
        "research_cutoff",
        "requested_at",
        "url",
        "status",
        "values"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "source_role": {
          "$ref": "#/$defs/sourceRole"
        },
        "criticality": {
          "$ref": "#/$defs/criticality"
        },
        "information_type": {
          "type": "string",
          "minLength": 1
        },
        "candidate_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "research_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "source_page_path": {
          "type": "string",
          "pattern": "^source_pages[\\\\/][^\\\\/:*?\"<>|]+$"
        },
        "cache_status": {
          "enum": [
            "MISS",
            "HIT",
            "STALE",
            "NOT_CACHEABLE"
          ]
        },
        "status": {
          "$ref": "#/$defs/sourceStatus"
        },
        "values": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN",
            null
          ]
        },
        "coverage_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "coverage_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "covered_dates": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "result_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acquisition_method": {
          "enum": [
            "HTTP_GET"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_exit_code": {
          "type": "integer"
        },
        "source_page_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_page_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "FOUND"
              }
            }
          },
          "then": {
            "properties": {
              "result_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "result_count": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "source_attempts": {
            "type": "array",
            "items": {
              "if": {
                "properties": {
                  "status": {
                    "const": "FOUND"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "acquisition_method",
                  "http_status",
                  "content_type",
                  "transport_exit_code",
                  "source_page_path",
                  "source_page_sha256",
                  "source_page_size_bytes"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
