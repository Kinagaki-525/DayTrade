{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "title": "Nightly source ledger",
  "type": "object",
  "required": ["schema_version", "target_date", "sources", "source_attempts"],
  "properties": {
    "schema_version": {"const": 1},
    "target_date": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceValue"
      }
    },
    "source_attempts": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceAttempt"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceStatus": {
      "enum": [
        "FOUND",
        "NOT_FOUND",
        "NOT_YET_AVAILABLE",
        "ACCESS_FAILED",
        "PARSE_FAILED",
        "STALE",
        "CONFLICT",
        "SINGLE_SOURCE_ONLY",
        "SOURCE_POLICY_UNDEFINED"
      ]
    },
    "sourceRole": {
      "enum": ["PRIMARY", "SECONDARY", "AUDIT", "CONTEXT"]
    },
    "criticality": {
      "enum": [
        "TRADE_CRITICAL",
        "DISCOVERY_CRITICAL",
        "RULE_DEPENDENT",
        "CONTEXT"
      ]
    },
    "sourceValue": {
      "type": "object",
      "required": [
        "source_ref",
        "source_id",
        "source_role",
        "information_type",
        "source_status",
        "source_name",
        "source_url",
        "retrieved_at",
        "trading_date",
        "ticker",
        "field_name",
        "value"
      ],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "source_role": {"$ref": "#/$defs/sourceRole"},
        "information_type": {"type": "string", "minLength": 1},
        "source_status": {"const": "FOUND"},
        "source_name": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "pattern": "^https?://"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "trading_date": {"type": "string", "format": "date"},
        "ticker": {"type": "string", "minLength": 1},
        "field_name": {"type": "string", "minLength": 1},
        "value": {"not": {"type": "null"}}
      },
      "additionalProperties": false
    },
    "sourceAttempt": {
      "type": "object",
      "required": [
        "source_id",
        "source_role",
        "criticality",
        "information_type",
        "candidate_code",
        "target_date",
        "research_cutoff",
        "requested_at",
        "url",
        "status",
        "values"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "source_role": {"$ref": "#/$defs/sourceRole"},
        "criticality": {"$ref": "#/$defs/criticality"},
        "information_type": {"type": "string", "minLength": 1},
        "candidate_code": {"type": ["string", "null"]},
        "target_date": {"type": "string", "format": "date"},
        "research_cutoff": {"type": "string", "format": "date-time"},
        "requested_at": {"type": "string", "format": "date-time"},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "url": {"type": "string", "pattern": "^https?://"},
        "status": {"$ref": "#/$defs/sourceStatus"},
        "values": {
          "oneOf": [
            {"type": "object"},
            {"type": "array"},
            {"type": "null"}
          ]
        },
        "result_count": {"type": ["integer", "null"], "minimum": 0},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
