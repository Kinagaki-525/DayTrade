{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selection_calibration.schema.json",
  "title": "Selection Calibration v1 report (Schema v2)",
  "type": "object",
  "required": [
    "schema_version",
    "calibration_version",
    "calibration_status",
    "status_reason_codes",
    "cohort",
    "dataset",
    "readiness",
    "candidate_space",
    "evaluated_threshold_pairs",
    "calibration_policy"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "calibration_version": {"const": "selection-calibration-v1"},
    "calibration_status": {"enum": ["COMPLETE", "DATA_UNAVAILABLE"]},
    "status_reason_codes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "cohort": {"$ref": "#/$defs/cohort"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "readiness": {"$ref": "#/$defs/readiness"},
    "candidate_space": {"$ref": "#/$defs/candidateSpace"},
    "evaluated_threshold_pairs": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluatedThresholdPair"}
    },
    "calibration_policy": {"$ref": "#/$defs/calibrationPolicy"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ratio": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "rate": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "cohort": {
      "type": "object",
      "required": [
        "cohort_id",
        "strategy_version",
        "ranking_version",
        "ranking_schema_version",
        "selection_version",
        "calibration_context_sha256",
        "source_matrix_raw_sha256"
      ],
      "properties": {
        "cohort_id": {"$ref": "#/$defs/sha256"},
        "strategy_version": {"type": "string", "minLength": 1},
        "ranking_version": {"const": "ranking-v1"},
        "ranking_schema_version": {"const": 1},
        "selection_version": {"type": "string", "minLength": 1},
        "calibration_context_sha256": {"$ref": "#/$defs/sha256"},
        "source_matrix_raw_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["observation_count", "excluded_count", "observations", "excluded_observations"],
      "properties": {
        "observation_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/observation"}
        },
        "excluded_observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/excludedObservation"}
        }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": ["status", "policy_version"],
      "properties": {
        "status": {"const": "NOT_ASSESSED"},
        "policy_version": {"const": null}
      },
      "additionalProperties": false
    },
    "candidateSpace": {
      "type": "object",
      "required": [
        "turnover_candidate_count",
        "relative_tick_candidate_count",
        "evaluated_pair_count",
        "minimum_turnover_yen",
        "maximum_relative_tick_size"
      ],
      "properties": {
        "turnover_candidate_count": {"type": "integer", "minimum": 0},
        "relative_tick_candidate_count": {"type": "integer", "minimum": 0},
        "evaluated_pair_count": {"type": "integer", "minimum": 0},
        "minimum_turnover_yen": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "maximum_relative_tick_size": {
          "type": "array",
          "items": {"$ref": "#/$defs/ratio"}
        }
      },
      "additionalProperties": false
    },
    "calibrationPolicy": {
      "type": "object",
      "required": [
        "candidate_policy",
        "fallback_policy",
        "rule_logic",
        "candidate_generation",
        "performance_objective",
        "automatic_threshold_selection"
      ],
      "properties": {
        "candidate_policy": {"const": "rank1_only"},
        "fallback_policy": {"const": "none"},
        "rule_logic": {"const": "all"},
        "candidate_generation": {"const": "observed_breakpoints"},
        "performance_objective": {"const": "none"},
        "automatic_threshold_selection": {"const": false}
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "observation_id",
        "target_date",
        "previous_trading_day",
        "rank1",
        "ranking_identity",
        "provenance",
        "cohort_id"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/sha256"},
        "target_date": {"type": "string", "format": "date"},
        "previous_trading_day": {"type": "string", "format": "date"},
        "rank1": {
          "type": "object",
          "required": ["ticker", "turnover_yen", "relative_tick_size"],
          "properties": {
            "ticker": {"type": "string", "minLength": 1},
            "turnover_yen": {"type": "integer", "minimum": 0},
            "relative_tick_size": {"$ref": "#/$defs/ratio"}
          },
          "additionalProperties": false
        },
        "ranking_identity": {
          "type": "object",
          "required": [
            "ranking_schema_version",
            "ranking_version",
            "strategy_version",
            "config_sha256"
          ],
          "properties": {
            "ranking_schema_version": {"const": 1},
            "ranking_version": {"const": "ranking-v1"},
            "strategy_version": {"type": "string", "minLength": 1},
            "config_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": [
            "ranking_raw_sha256",
            "event_gate_raw_sha256",
            "candidates_raw_sha256",
            "market_data_raw_sha256",
            "sources_raw_sha256",
            "source_matrix_raw_sha256",
            "strategy_snapshot_raw_sha256"
          ],
          "properties": {
            "ranking_raw_sha256": {"$ref": "#/$defs/sha256"},
            "event_gate_raw_sha256": {"$ref": "#/$defs/sha256"},
            "candidates_raw_sha256": {"$ref": "#/$defs/sha256"},
            "market_data_raw_sha256": {"$ref": "#/$defs/sha256"},
            "sources_raw_sha256": {"$ref": "#/$defs/sha256"},
            "source_matrix_raw_sha256": {"$ref": "#/$defs/sha256"},
            "strategy_snapshot_raw_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "cohort_id": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "excludedObservation": {
      "type": "object",
      "required": ["target_date", "disposition", "reason_code"],
      "properties": {
        "target_date": {"type": "string", "format": "date"},
        "disposition": {"enum": ["TRUSTED_NOT_ELIGIBLE", "UNVERIFIED", "OUT_OF_COHORT"]},
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evaluatedThresholdPair": {
      "type": "object",
      "required": [
        "pair_id",
        "minimum_turnover_yen",
        "maximum_relative_tick_size",
        "observation_count",
        "selected_count",
        "rejected_count",
        "selection_rate",
        "rejected_turnover_only_count",
        "rejected_relative_tick_only_count",
        "rejected_both_count",
        "outcome_signature_sha256"
      ],
      "properties": {
        "pair_id": {"$ref": "#/$defs/sha256"},
        "minimum_turnover_yen": {"type": "integer", "minimum": 1},
        "maximum_relative_tick_size": {"$ref": "#/$defs/ratio"},
        "observation_count": {"type": "integer", "minimum": 1},
        "selected_count": {"type": "integer", "minimum": 0},
        "rejected_count": {"type": "integer", "minimum": 0},
        "selection_rate": {"$ref": "#/$defs/rate"},
        "rejected_turnover_only_count": {"type": "integer", "minimum": 0},
        "rejected_relative_tick_only_count": {"type": "integer", "minimum": 0},
        "rejected_both_count": {"type": "integer", "minimum": 0},
        "outcome_signature_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
