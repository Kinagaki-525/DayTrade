{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_data.schema.json",
  "title": "Nightly market data",
  "type": "object",
  "required": ["schema_version", "target_date", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "target_date": {"type": "string", "format": "date"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/marketRecord"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "decimalOrNull": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
        {"type": "null"}
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "source_ref",
        "source_id",
        "source_role",
        "information_type",
        "source_status",
        "source_name",
        "source_url",
        "retrieved_at",
        "trading_date",
        "ticker",
        "field_name",
        "value"
      ],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "source_role": {"enum": ["PRIMARY", "SECONDARY", "AUDIT", "CONTEXT"]},
        "information_type": {"type": "string", "minLength": 1},
        "source_status": {"const": "FOUND"},
        "source_name": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "pattern": "^https?://"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "trading_date": {"type": "string", "format": "date"},
        "ticker": {"type": ["string", "null"], "minLength": 1},
        "field_name": {"type": "string", "minLength": 1},
        "value": {"not": {"type": "null"}}
      },
      "additionalProperties": false
    },
    "marketRecord": {
      "type": "object",
      "required": [
        "ticker",
        "company_name",
        "market",
        "share_unit",
        "data_status",
        "trading_date",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "previous_close",
        "previous_high",
        "tick_size",
        "sources"
      ],
      "properties": {
        "ticker": {"type": ["string", "null"]},
        "company_name": {"type": ["string", "null"]},
        "market": {"type": ["string", "null"]},
        "share_unit": {"type": ["integer", "string", "null"]},
        "security_type": {"type": ["string", "null"]},
        "source_policy_status": {
          "enum": [
            "NOT_STARTED",
            "FOUND",
            "NOT_FOUND",
            "NOT_YET_AVAILABLE",
            "ACCESS_FAILED",
            "PARSE_FAILED",
            "STALE",
            "CONFLICT",
            "SINGLE_SOURCE_ONLY",
            "SOURCE_POLICY_UNDEFINED",
            "NOT_REQUIRED",
            "DEPENDENCY_NOT_READY",
            "EXECUTION_FAILED",
            null
          ]
        },
        "data_status": {
          "enum": [
            "VERIFIED",
            "DATA_UNAVAILABLE",
            "CONFLICT",
            "SINGLE_SOURCE_ONLY",
            "SOURCE_POLICY_UNDEFINED"
          ]
        },
        "data_status_reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "trading_date": {"type": ["string", "null"]},
        "open": {"$ref": "#/$defs/decimalOrNull"},
        "high": {"$ref": "#/$defs/decimalOrNull"},
        "low": {"$ref": "#/$defs/decimalOrNull"},
        "close": {"$ref": "#/$defs/decimalOrNull"},
        "volume": {"type": ["integer", "string", "null"]},
        "previous_close": {"$ref": "#/$defs/decimalOrNull"},
        "previous_high": {"$ref": "#/$defs/decimalOrNull"},
        "tick_size": {"$ref": "#/$defs/decimalOrNull"},
        "turnover": {"$ref": "#/$defs/decimalOrNull"},
        "spread": {"$ref": "#/$defs/decimalOrNull"},
        "earnings_scheduled": {"type": ["boolean", "null"]},
        "special_disclosures": {"type": ["boolean", "null"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "field_provenance": {
          "type": "array",
          "items": {"$ref": "#/$defs/fieldProvenance"}
        }
      },
      "additionalProperties": false
    },
    "fieldProvenance": {
      "type": "object",
      "required": [
        "field_name",
        "status",
        "verified_value",
        "primary_source_ref",
        "secondary_source_ref",
        "source_refs",
        "verified_at"
      ],
      "properties": {
        "field_name": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "VERIFIED",
            "DATA_UNAVAILABLE",
            "CONFLICT",
            "SINGLE_SOURCE_ONLY",
            "SOURCE_POLICY_UNDEFINED",
            "NOT_STARTED",
            "NOT_REQUIRED",
            "DEPENDENCY_NOT_READY",
            "EXECUTION_FAILED",
            "NOT_YET_AVAILABLE",
            "PARSE_FAILED",
            "ACCESS_FAILED",
            "STALE"
          ]
        },
        "verified_value": {"type": ["number", "integer", "string", "boolean", "null"]},
        "primary_source_ref": {"type": ["string", "null"], "minLength": 1},
        "secondary_source_ref": {"type": ["string", "null"], "minLength": 1},
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
