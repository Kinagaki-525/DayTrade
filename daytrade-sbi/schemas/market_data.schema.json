{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_data.schema.json",
  "title": "Nightly market data",
  "type": "object",
  "required": ["schema_version", "target_date", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "target_date": {"type": "string", "format": "date"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/marketRecord"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "decimalOrNull": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
        {"type": "null"}
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "source_name",
        "source_url",
        "retrieved_at",
        "trading_date",
        "ticker",
        "field_name",
        "value"
      ],
      "properties": {
        "source_name": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "pattern": "^https?://"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "trading_date": {"type": "string", "format": "date"},
        "ticker": {"type": "string", "minLength": 1},
        "field_name": {"type": "string", "minLength": 1},
        "value": {"not": {"type": "null"}}
      },
      "additionalProperties": false
    },
    "marketRecord": {
      "type": "object",
      "required": [
        "ticker",
        "company_name",
        "trading_date",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "previous_close",
        "previous_high",
        "tick_size",
        "sources"
      ],
      "properties": {
        "ticker": {"type": ["string", "null"]},
        "company_name": {"type": ["string", "null"]},
        "trading_date": {"type": ["string", "null"]},
        "open": {"$ref": "#/$defs/decimalOrNull"},
        "high": {"$ref": "#/$defs/decimalOrNull"},
        "low": {"$ref": "#/$defs/decimalOrNull"},
        "close": {"$ref": "#/$defs/decimalOrNull"},
        "volume": {"type": ["integer", "string", "null"]},
        "previous_close": {"$ref": "#/$defs/decimalOrNull"},
        "previous_high": {"$ref": "#/$defs/decimalOrNull"},
        "tick_size": {"$ref": "#/$defs/decimalOrNull"},
        "turnover": {"$ref": "#/$defs/decimalOrNull"},
        "spread": {"$ref": "#/$defs/decimalOrNull"},
        "earnings_scheduled": {"type": ["boolean", "null"]},
        "special_disclosures": {"type": ["boolean", "null"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      },
      "additionalProperties": false
    }
  }
}
