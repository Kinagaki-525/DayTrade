{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recommendation.schema.json",
  "title": "Codex nightly recommendation",
  "type": "object",
  "required": [
    "schema_version",
    "target_date",
    "strategy_version",
    "config_sha256",
    "decision",
    "strategy_type",
    "ticker",
    "company_name",
    "previous_high",
    "tick_size",
    "entry_trigger",
    "entry_limit",
    "take_profit",
    "stop_loss",
    "shares",
    "selection_reasons",
    "research_cutoff",
    "post_cutoff_information_status",
    "pipeline_summary",
    "source_urls",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "target_date": {"type": "string", "format": "date"},
    "strategy_version": {"type": "string", "minLength": 1},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["TRADE", "NO_TRADE", "DATA_UNAVAILABLE"]},
    "strategy_type": {"type": ["string", "null"]},
    "ticker": {"type": ["string", "null"]},
    "company_name": {"type": ["string", "null"]},
    "previous_high": {"$ref": "#/$defs/decimalOrNull"},
    "tick_size": {"$ref": "#/$defs/decimalOrNull"},
    "entry_trigger": {"$ref": "#/$defs/decimalOrNull"},
    "entry_limit": {"$ref": "#/$defs/decimalOrNull"},
    "take_profit": {"$ref": "#/$defs/decimalOrNull"},
    "stop_loss": {"$ref": "#/$defs/decimalOrNull"},
    "shares": {"type": ["integer", "null"]},
    "selection_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "research_cutoff": {"type": ["string", "null"], "format": "date-time"},
    "post_cutoff_information_status": {
      "enum": ["NO_NON_BUSINESS_GAP", "OUT_OF_SCOPE"]
    },
    "pipeline_summary": {"$ref": "#/$defs/pipelineSummary"},
    "source_statuses": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceStatusRecord"}
    },
    "source_urls": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^https?://"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["decision"],
        "properties": {"decision": {"const": "TRADE"}}
      },
      "then": {
        "properties": {
          "strategy_type": {"const": "previous_day_high_breakout"},
          "ticker": {"type": "string", "minLength": 1},
          "company_name": {"type": "string", "minLength": 1},
          "previous_high": {"$ref": "#/$defs/decimal"},
          "tick_size": {"$ref": "#/$defs/decimal"},
          "entry_trigger": {"$ref": "#/$defs/decimal"},
          "entry_limit": {"$ref": "#/$defs/decimal"},
          "take_profit": {"$ref": "#/$defs/decimal"},
          "stop_loss": {"$ref": "#/$defs/decimal"},
          "shares": {"const": 100},
          "source_urls": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "strategy_type": {"type": "null"},
          "ticker": {"type": "null"},
          "company_name": {"type": "null"},
          "previous_high": {"type": "null"},
          "tick_size": {"type": "null"},
          "entry_trigger": {"type": "null"},
          "entry_limit": {"type": "null"},
          "take_profit": {"type": "null"},
          "stop_loss": {"type": "null"},
          "shares": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sourceStatus": {
      "enum": [
        "NOT_STARTED",
        "FOUND",
        "NOT_FOUND",
        "NOT_YET_AVAILABLE",
        "ACCESS_FAILED",
        "PARSE_FAILED",
        "STALE",
        "CONFLICT",
        "SINGLE_SOURCE_ONLY",
        "SOURCE_POLICY_UNDEFINED",
        "NOT_REQUIRED",
        "DEPENDENCY_NOT_READY",
        "EXECUTION_FAILED"
      ]
    },
    "pipelineSummary": {
      "type": "object",
      "required": [
        "discovered",
        "research_complete",
        "research_incomplete",
        "data_unavailable",
        "screened",
        "eligible",
        "rejected",
        "pipeline_complete",
        "stage2_target_count",
        "stage2_completed_count",
        "stage2_unavailable_count",
        "stage2_incomplete_count",
        "coverage_rate",
        "research_incomplete_reason_counts"
      ],
      "properties": {
        "discovered": {"type": "integer", "minimum": 0},
        "research_complete": {"type": "integer", "minimum": 0},
        "research_incomplete": {"type": "integer", "minimum": 0},
        "data_unavailable": {"type": "integer", "minimum": 0},
        "screened": {"type": "integer", "minimum": 0},
        "eligible": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "pipeline_complete": {"type": "boolean"},
        "stage2_target_count": {"type": "integer", "minimum": 0},
        "stage2_completed_count": {"type": "integer", "minimum": 0},
        "stage2_unavailable_count": {"type": "integer", "minimum": 0},
        "stage2_incomplete_count": {"type": "integer", "minimum": 0},
        "coverage_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "research_incomplete_reason_counts": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/researchIncompleteReason"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "researchIncompleteReason": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "SUBAGENT_RESULT_NOT_MERGED",
        "DEPENDENCY_NOT_READY",
        "EXECUTION_FAILED",
        "UNKNOWN"
      ]
    },
    "sourceStatusRecord": {
      "type": "object",
      "required": ["source_id", "status", "url"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "status": {"$ref": "#/$defs/sourceStatus"},
        "url": {"type": "string", "pattern": "^https?://"},
        "candidate_code": {"type": ["string", "null"]},
        "information_type": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "decimal": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}
      ]
    },
    "decimalOrNull": {
      "oneOf": [
        {"$ref": "#/$defs/decimal"},
        {"type": "null"}
      ]
    }
  }
}
