#!/usr/bin/env python3
"""DEVELOPMENT-ONLY convenience entry point for a Development Claude session.

It resolves the git repository root from the source tree and ``chdir``s there
immediately before ``exec claude`` -- so a human may call it from
``daytrade-sbi/`` (or anywhere else) and Claude still starts at the repository
root, where the Claude Sandbox can write ``.git`` and ``git add`` /
``git commit`` therefore work with the sandbox fully enabled.

    daytrade-sbi/scripts/claude-development

Starting raw ``claude`` from the repository root is equally official
(DTWO-2026-026). This wrapper only spares the human from remembering where to
stand; it grants nothing that raw ``claude`` does not already have.

NOT A SECURITY BOUNDARY. It disables no sandbox, relaxes no permission, writes
no file, and checks nothing about the host beyond where the repository is.

The launcher core lives in ``src/claude_development_launcher.py`` so that it is
unit-testable; this file stays a thin entry point.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from src.claude_development_launcher import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
