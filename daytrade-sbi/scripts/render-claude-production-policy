#!/usr/bin/env python3
"""Render the DayTrade Claude Code production Managed Policy to stdout.

This writes NOTHING to /etc. A human reviews the rendered JSON before the
(root-only) deploy script is run.

    scripts/render-claude-production-policy \
        --production-python /usr/bin/python3 > /tmp/managed-settings.json
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from src.claude_runtime_security import (  # noqa: E402
    MANAGED_GUARD_PATH,
    RuntimeSecurityError,
    render_managed_settings_json,
)


def main(argv: list[str] | None = None) -> int:
    daytrade_root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--production-python", required=True)
    parser.add_argument("--project-root", default=str(daytrade_root.parent))
    parser.add_argument("--daytrade-root", default=str(daytrade_root))
    parser.add_argument("--guard-path", default=str(MANAGED_GUARD_PATH))
    args = parser.parse_args(argv)

    try:
        sys.stdout.write(
            render_managed_settings_json(
                project_root=args.project_root,
                daytrade_root=args.daytrade_root,
                production_python=args.production_python,
                guard_path=args.guard_path,
            )
        )
    except RuntimeSecurityError as error:
        sys.stderr.write(f"{error}\n")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
