#!/usr/bin/env python3
"""HUMAN-ONLY: verify one sealed Production Run Archive against its manifest.

    scripts/verify-production-archive --target-date 2026-08-25

Read-only. Re-hashes every archived file, checks the manifest and its digest,
confirms no file was added or removed, and re-derives the business status of
the archived run for comparison with the stored one.

A difference between the stored and the re-derived business status means the
Production Verifier's rules changed since the archive was sealed. That is
reported, never "repaired": the archive is decided by raw bytes and the
manifest alone.

There is no ``--force`` and nothing here writes to the archive.

Not a ``src.cli`` subcommand, so never a pipeline stage.

Exit codes: 0 = ARCHIVE_VERIFIED, 2 = contract violation.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from src.production_archive import verify_main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(verify_main())
