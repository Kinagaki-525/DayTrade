#!/usr/bin/env python3
"""HUMAN-ONLY: reparse one stopped Production run's stored Discovery evidence.

    scripts/reparse-production-discovery --target-date 2026-08-27

NO NETWORK. Production recovery only. **A coding agent must never run this
script** -- not Production Claude, not Development Claude, not Codex. When a
Production Nightly stopped at Discovery and a parser fix has since been
merged, the agent reports the situation and hands the run back to a human;
the human runs this from an ordinary shell.

``--target-date`` is the only input. The DayTrade root, the run directory
(``runs/<target-date>``), the Source Matrix and the two Discovery source ids
are all fixed inside ``src/production_discovery_reparse.py`` and cannot be
redirected from the command line. There is no ``--force``, no ``--run-dir``,
no ``--parser``, no ``--allow-network``.

What it does: re-runs the *current* deterministic parser over the raw bytes
already stored under ``source_pages/``, and -- only if both ranking routes
then confirm a full TOP50 -- atomically rewrites the parser-derived fields of
exactly those two Logical Attempts in ``sources.json``.

What it never does: no HTTP GET, no retry, no new Physical Request, no
mutation or deletion of ``network_requests/*.json`` or ``source_pages/*``, no
``attempt_id`` / ``request_id`` change, no ``market_research.json`` write, no
downstream repair. If any artifact after Discovery already exists, or the
current parser still cannot confirm a full TOP50, it writes nothing at all.

Afterwards the human restarts Production Claude and the canonical
``acquire-discovery`` runs as usual -- reusing the corrected Logical Attempts
and spending zero network requests.

Not a ``src.cli`` subcommand: it can never appear in the Canonical CLI
Pipeline Order.

Exit codes: 0 = REPARSED / ALREADY_REPARSED, 2 = contract violation.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from src.production_discovery_reparse import reparse_main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(reparse_main())
