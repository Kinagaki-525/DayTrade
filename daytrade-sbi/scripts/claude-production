#!/usr/bin/env python3
"""HUMAN-ONLY entry point for a DayTrade production nightly Claude Code run.

A **Production Context Launcher** (DTWO-2026-026): it checks that this checkout
is in a state a nightly may run from -- a real ``--target-date``, ``main``, no
half-finished git operation, no uncommitted tracked file, a resolvable HEAD --
exports the run context, and ``exec``s Claude Code from ``daytrade-sbi/``.

It is not a security gate. It reads no ``/etc`` marker, no OS managed policy,
no runtime guard and no seccomp attestation; it pins no Claude Code version and
touches no network. What makes a nightly result trustworthy is the business
pipeline itself: Raw Evidence with SHA256, the Source Ledger, the deterministic
parsers, the Trust Chain and the Risk Engine, each of which still fails closed.

A refusal here is an operational start failure, never a business decision: it is
not ``NO_TRADE`` and not ``DATA_UNAVAILABLE``.

The launcher core lives in ``src/claude_production_launcher.py`` so that it is
unit-testable; this file stays a thin entry point.

A coding agent must never run this script.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from src.claude_production_launcher import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
