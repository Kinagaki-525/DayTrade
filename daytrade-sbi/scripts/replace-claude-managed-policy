#!/usr/bin/env python3
"""HUMAN-ONLY: replace a reviewed DayTrade Claude Code Managed Policy.

This is NOT the installer. ``deploy-claude-managed-policy`` installs a policy
on a host that has none and refuses, always, to touch one that already exists.
This script is the other half: replacing a policy that a human has reviewed
with a candidate that a human has reviewed.

Both reviews are named by exact SHA256, and neither is inferred:

    --expected-installed-sha256   the policy currently on this host, reviewed
                                  and authorised for replacement
    --expected-rendered-sha256    the candidate rendered from the reviewed
                                  repository state

There is deliberately no --force. If either hash does not match, or the
installed Runtime Guard is not the repository's canonical guard, nothing is
written.

Use --check first: it renders the candidate, reports both hashes and whether
the installed policy is stale, and writes nothing at all.

A coding agent must never run this script against Production.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from src.claude_runtime_security import (  # noqa: E402
    DEFAULT_MANAGED_ROOT,
    MANAGED_GUARD_PATH,
    RuntimeSecurityError,
    inspect_managed_policy_replacement,
    render_managed_settings,
    replace_managed_policy,
)


def main(argv: list[str] | None = None) -> int:
    daytrade_root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--production-python", required=True)
    parser.add_argument("--project-root", default=str(daytrade_root.parent))
    parser.add_argument("--daytrade-root", default=str(daytrade_root))
    parser.add_argument("--target-root", default=str(DEFAULT_MANAGED_ROOT))
    parser.add_argument(
        "--check",
        action="store_true",
        help="report replacement readiness; writes nothing",
    )
    parser.add_argument(
        "--expected-installed-sha256",
        help="SHA256 of the reviewed policy currently installed on this host",
    )
    parser.add_argument(
        "--expected-rendered-sha256",
        help="SHA256 of the reviewed candidate rendered from this repository",
    )
    args = parser.parse_args(argv)

    if not args.check and os.geteuid() != 0:
        sys.stderr.write(
            "ERROR: replace-claude-managed-policy must run as root\n"
        )
        return 1
    if not args.check and not (
        args.expected_installed_sha256 and args.expected_rendered_sha256
    ):
        sys.stderr.write(
            "ERROR: both --expected-installed-sha256 and "
            "--expected-rendered-sha256 are required; run --check first to "
            "obtain them, and review both artefacts before replacing\n"
        )
        return 1

    try:
        rendered = render_managed_settings(
            project_root=args.project_root,
            daytrade_root=args.daytrade_root,
            production_python=args.production_python,
            guard_path=MANAGED_GUARD_PATH,
        )
        if args.check:
            result = inspect_managed_policy_replacement(
                target_root=args.target_root,
                rendered_settings=rendered,
            )
        else:
            result = replace_managed_policy(
                target_root=args.target_root,
                rendered_settings=rendered,
                expected_installed_sha256=args.expected_installed_sha256,
                expected_rendered_sha256=args.expected_rendered_sha256,
            )
    except RuntimeSecurityError as error:
        sys.stderr.write(f"ERROR: {error}\n")
        return 2

    for key, value in sorted(result.items()):
        sys.stdout.write(f"{key}={value}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
